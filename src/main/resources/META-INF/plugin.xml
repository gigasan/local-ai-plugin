<idea-plugin>
    <id>com.gigasan.ai</id>
    <name>Local AI Chat</name>
    <version>0.5.0</version>
    <vendor url="https://github.com/gigasan">GigaSan</vendor>

    <description>
        A lightweight AI chat tool integrated into your IDE.
        Connect to local or self-hosted models using REST API (LM Studio, OpenAI-compatible, or custom endpoints).
        Supports sending code snippets, files, and text with a user-friendly interface right in the workflow.
    </description>

    <dependencies>
        <!-- Обязательный базовый модуль -->
        <plugin id="com.intellij.modules.platform" />
        <plugin id="com.intellij.modules.lang" />
    </dependencies>

    <!-- Optional Kotlin (только если пользователь установит Kotlin-плагин) -->
    <depends optional="true" config-file="com.gigasan.ai-withKotlin.xml">org.jetbrains.kotlin</depends>

    <!-- Optional Rust (только если пользователь установит Rust-плагин) -->
    <depends optional="true" config-file="com.gigasan.ai-withRust.xml">com.jetbrains.rust</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceInterface="com.gigasan.ai.config.PluginConfigProvider"
                serviceImplementation="com.gigasan.ai.config.DefaultChatConfigProvider"/>
        <applicationService serviceImplementation="com.gigasan.ai.config.storage.PluginSettingsService"/>
        <projectConfigurable
                displayName="Local AI Chat Settings"
                id="com.gigasan.ai.config.PluginSettingsConfigurable"
                instance="com.gigasan.ai.config.PluginSettingsConfigurable"/>
        <toolWindow
            id="Local AI Chat"
            factoryClass="com.gigasan.ai.ui.chat.ChatToolWindowFactory"
            anchor="right"
            icon="/icons/chat.svg"
            secondary="true"/>
    </extensions>

    <actions>
        <group id="LocalAIGroup"
               text="Local AI"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <action id="LocalAI.Enqueue"
                class="com.gigasan.ai.actions.EnqueueAction"
                text="Enqueue the Task Local AI Model"
                description="Send selected text into AI task">
            <add-to-group group-id="LocalAIGroup" anchor="last"/>
        </action>
    </actions>

    <applicationListeners>
        <listener class="com.gigasan.ai.config.MyPluginInitializer"
                  topic="com.intellij.ide.AppLifecycleListener"/>
    </applicationListeners>

</idea-plugin>